# CorpusForge local development defaults.
# Copy to .env and override as needed. Docker Compose also injects
# service hostnames so `docker compose up` works without a .env file.

APP_NAME=CorpusForge
APP_ENV=development
DEBUG=true
SECRET_KEY=dev-only-change-me
CREDENTIAL_ENCRYPTION_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3001

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=corpusforge
POSTGRES_PASSWORD=corpusforge
POSTGRES_DB=corpusforge

REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2
CELERY_WORKER_CONCURRENCY=2

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=corpusforge
S3_REGION=us-east-1

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

MAX_UPLOAD_SIZE_BYTES=52428800
LOG_LEVEL=INFO
LOG_FORMAT=json

PDF_OCR_ENABLED=true
PDF_OCR_MIN_CHARS_PER_PAGE=40
NEAR_DUPLICATE_MAX_HAMMING=3
NEAR_DUPLICATE_SCAN_LIMIT=500
CHUNK_STRATEGY=parent_child
CHUNK_SIZE=256
CHUNK_OVERLAP=32
PARENT_CHUNK_MAX_TOKENS=1024
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=gemini
LLM_MODEL=gpt-4o-mini
RERANKER_PROVIDER=cohere
RERANKER_ENABLED=true
RERANKER_MODEL=rerank-v3.5
COHERE_API_KEY=
COHERE_BASE_URL=https://api.cohere.com
