# CorpusForge local development defaults.
# Copy to .env and override as needed. Docker Compose also injects
# service hostnames so `docker compose up` works without a .env file.

APP_NAME=CorpusForge
APP_ENV=development
DEBUG=true
SECRET_KEY=dev-only-change-me
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_USER=corpusforge
POSTGRES_PASSWORD=corpusforge
POSTGRES_DB=corpusforge

REDIS_URL=redis://localhost:6380/0
CELERY_BROKER_URL=redis://localhost:6380/1
CELERY_RESULT_BACKEND=redis://localhost:6380/2
CELERY_WORKER_CONCURRENCY=2

S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=corpusforge
S3_REGION=us-east-1

QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=

MAX_UPLOAD_SIZE_BYTES=52428800
LOG_LEVEL=INFO
LOG_FORMAT=json
